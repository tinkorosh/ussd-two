<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_badge"
            android:gravity="center">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_add"
                android:tint="#38BDF8"
                android:contentDescription="Add Preset" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Quick Action Preset"
            android:textColor="#F8FAFC"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <!-- Name input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PRESET NAME"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/dialogPresetNameInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_field"
        android:hint="e.g. Daily Data, Telebirr Transfer"
        android:textColorHint="#475569"
        android:textColor="#F8FAFC"
        android:textSize="14sp"
        android:inputType="textCapWords"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginBottom="14dp"/>

    <!-- USSD Code input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="USSD CODE"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/dialogPresetCodeInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_field"
        android:hint="e.g. *999# or *804#"
        android:textColorHint="#475569"
        android:textColor="#F8FAFC"
        android:textSize="15sp"
        android:textStyle="bold"
        android:inputType="phone"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginBottom="14dp"/>

    <!-- Target SIM selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PREFERRED SIM SLOT"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:layout_marginBottom="8dp"/>

    <RadioGroup
        android:id="@+id/dialogSimRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <RadioButton
            android:id="@+id/dialogRadioSim1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SIM 1"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/dialogRadioSim2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SIM 2"
            android:textColor="#C084FC"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <RadioButton
            android:id="@+id/dialogRadioDefault"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Default"
            android:textColor="#FBBF24"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </RadioGroup>

    <!-- Dialog Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dialogCancelBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_sim"
            android:text="Cancel"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"
            style="?android:attr/borderlessButtonStyle"/>

        <Button
            android:id="@+id/dialogSaveBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:text="Save Preset"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            style="?android:attr/borderlessButtonStyle"/>
    </LinearLayout>
</LinearLayout>
