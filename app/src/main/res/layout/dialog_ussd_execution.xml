<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Bottom sheet drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_code_chip" />

    <!-- Top Status Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvExecutionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Executing USSD"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvExecutionSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="In-App Direct Cellular Query"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- USSD Code Badge -->
        <TextView
            android:id="@+id/tvExecutionCodeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_code_chip"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="*999#"
            android:textColor="@color/primary_blue_light"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- SIM Info Chip -->
    <TextView
        android:id="@+id/tvExecutionSimBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_badge_sim1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="SIM 1 • Ethio telecom"
        android:textColor="@color/primary_blue_light"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- 1. LOADING VIEW -->
    <LinearLayout
        android:id="@+id/layoutExecutionLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="24dp"
        android:visibility="visible">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            app:indicatorColor="@color/primary_blue"
            app:trackColor="@color/primary_blue_container"
            app:trackThickness="4dp" />

        <TextView
            android:id="@+id/tvLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Querying mobile network in-app..."
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Direct response will appear here without switching apps"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelLoading"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- 2. SUCCESS VIEW -->
    <LinearLayout
        android:id="@+id/layoutExecutionSuccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check"
                app:tint="@color/accent_green"
                android:contentDescription="Success Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Carrier Network Response"
                android:textColor="@color/accent_green"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Response Card with Selectable Text -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_dark"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tvExecutionResponseText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.3"
                android:padding="16dp"
                android:textIsSelectable="true"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                tools:text="Your current balance is 125.50 ETB. Valid until 2026-10-20. Internet bundle: 1.5 GB remaining." />
        </com.google.android.material.card.MaterialCardView>

        <!-- Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyExecutionResponse"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Copy"
                android:textColor="@color/text_primary"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_copy"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconTint="@color/primary_blue_light" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDoneExecution"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/primary_blue"
                android:text="Done"
                android:textColor="@color/white"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. ERROR / FALLBACK VIEW -->
    <LinearLayout
        android:id="@+id/layoutExecutionError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_dialpad"
                app:tint="@color/accent_amber"
                android:contentDescription="Notice Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Interactive Session or Dial Required"
                android:textColor="@color/accent_amber"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/accent_amber_container"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/accent_amber"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tvExecutionErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:padding="16dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                tools:text="This USSD code may require interactive multi-step inputs or dialer routing for this carrier." />
        </com.google.android.material.card.MaterialCardView>

        <!-- Fallback Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDismissError"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:text="Dismiss"
                android:textColor="@color/text_secondary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialViaPhoneApp"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:backgroundTint="@color/accent_amber"
                android:text="Dial via Dialer"
                android:textColor="@color/bg_dark"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_dialpad"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconTint="@color/bg_dark" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
