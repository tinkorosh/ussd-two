<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_preset_item"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="10dp">

    <!-- SIM badge -->
    <TextView
        android:id="@+id/presetSimBadge"
        android:layout_width="48dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_sim1_badge"
        android:text="SIM 1"
        android:textColor="#38BDF8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/presetNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Action"
            android:textColor="#F8FAFC"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/presetCodeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="*999#"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Dial button -->
        <Button
            android:id="@+id/presetDialBtn"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_button_sim1"
            android:text="Dial"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_phone"
            android:drawablePadding="6dp"
            android:drawableTint="#FFFFFF"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:stateListAnimator="@null"
            style="?android:attr/borderlessButtonStyle"/>

        <!-- Delete button (visible for custom items) -->
        <ImageButton
            android:id="@+id/presetDeleteBtn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_trash"
            android:tint="#64748B"
            android:contentDescription="Delete Preset"
            android:layout_marginStart="4dp"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
