<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_preset_item"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="10dp">

    <!-- SIM badge -->
    <TextView
        android:id="@+id/presetSimBadge"
        android:layout_width="48dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_sim1_badge"
        android:text="SIM 1"
        android:textColor="#38BDF8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/presetNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Action"
            android:textColor="#F8FAFC"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/presetCodeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="*999#"
                android:textColor="#94A3B8"
                android:textSize="12sp"/>

            <!-- PIN indicator badge -->
            <TextView
                android:id="@+id/presetPinBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● PIN SET"
                android:textColor="#F59E0B"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Dial button (strictly labeled Dial with vibrant emerald styling) -->
        <Button
            android:id="@+id/presetDialBtn"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_button_dial"
            app:backgroundTint="@null"
            android:text="Dial"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_phone"
            android:drawablePadding="6dp"
            android:drawableTint="#FFFFFF"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:stateListAnimator="@null"
            style="?android:attr/borderlessButtonStyle"/>

        <!-- Edit button (allows editing preset, PIN, and deleting) -->
        <ImageButton
            android:id="@+id/presetEditBtn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_edit"
            android:tint="#94A3B8"
            android:contentDescription="Edit Preset &amp; PIN"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
</LinearLayout>
