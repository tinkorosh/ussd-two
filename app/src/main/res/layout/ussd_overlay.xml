<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0E17"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="28dp"
    android:paddingBottom="20dp"
    android:fitsSystemWindows="true"
    android:clickable="true"
    android:focusable="true">

    <!-- Top Handle / Indicator -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_drag_handle"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"/>

    <!-- Header Bar with Live Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_dialpad"
            android:contentDescription="USSD" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="USSD ASSISTANT"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginStart="8dp"/>

        <!-- Live indicator pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_active"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <ImageView
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:src="@drawable/ic_live_dot"
                android:contentDescription="Live"
                android:layout_marginEnd="5dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVE SESSION"
                android:textColor="#34D399"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Loading State Layout (Shown while "USSD code running...") -->
    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ProgressBar
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:indeterminateTint="#38BDF8"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:id="@+id/overlayLoadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connecting with carrier network..."
                android:textColor="#F8FAFC"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please wait while your session is established"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Main Content Layout (Shown when a menu is parsed) -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Menu Prompt Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_menu_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CARRIER RESPONSE"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/overlayMenuText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Select an option"
                        android:textColor="#F8FAFC"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:lineSpacingMultiplier="1.25"/>
                </LinearLayout>

                <!-- Quick Confirm Card (Shown when carrier says "To confirm press 1" or similar) -->
                <LinearLayout
                    android:id="@+id/quickConfirmCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="12dp"
                    android:layout_marginBottom="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONFIRMATION DETECTED"
                        android:textColor="#34D399"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="6dp"/>

                    <Button
                        android:id="@+id/btnQuickConfirmOne"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_confirm_btn"
                        android:text="✓ CONFIRM (PRESS 1)"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:stateListAnimator="@null"
                        style="?android:attr/borderlessButtonStyle"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/actionsSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SELECT AN ACTION"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="10dp"/>

                <!-- Container where option buttons are added -->
                <LinearLayout
                    android:id="@+id/overlayOptionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <!-- Custom Input / PIN Entry Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/customInputTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="CUSTOM INPUT / PIN ENTRY"
                            android:textColor="#38BDF8"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"/>

                        <TextView
                            android:id="@+id/toggleKeypadBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KEYPAD ▾"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:padding="4dp"/>
                    </LinearLayout>

                    <!-- Input row with text and send button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/overlayCustomInput"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input_field"
                            android:hint="Enter PIN, 1, or amount..."
                            android:textColorHint="#64748B"
                            android:textColor="#F8FAFC"
                            android:textSize="15sp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:inputType="text"
                            android:singleLine="true"
                            android:imeOptions="actionSend"/>

                        <Button
                            android:id="@+id/overlaySendCustomBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:minWidth="76dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_button_accent"
                            android:text="SEND"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:stateListAnimator="@null"
                            style="?android:attr/borderlessButtonStyle"/>
                    </LinearLayout>

                    <!-- Built-in Numeric Keypad (1-9, *, 0, #, Backspace) -->
                    <LinearLayout
                        android:id="@+id/keypadContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp"
                        android:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <Button
                                android:id="@+id/keypad1"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_keypad_btn"
                                android:text="1"
                                android:textColor="#F8FAFC"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:stateListAnimator="@null"
                                style="?android:attr/borderlessButtonStyle"/>

                            <Button
                                android:id="@+id/keypad2"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_keypad_btn"
                                android:text="2"
                                android:textColor="#F8FAFC"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:stateListAnimator="@null"
                                style="?android:attr/borderlessButtonStyle"/>

                            <Button
                                android:id="@+id/keypad3"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_keypad_btn"
                                android:text="3"
                                android:textColor="#F8FAFC"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:stateListAnimator="@null"
                                style="?android:attr/borderlessButtonStyle"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <Button
                                android:id="@+id/keypad4"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_keypad_btn"
                                android:text="4"
                                android:textColor="#F8FAFC"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:stateListAnimator="@null"
                                style="?android:attr/borderlessButtonStyle"/>

                            <Button
                                android:id="@+id/keypad5"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_keypad_btn"
                                android:text="5"
                                android:textColor="#F8FAFC"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:stateListAnimator="@null"
                                style="?android:attr/borderlessButtonStyle"/>

                            <Button
                                android:id="@+id/keypad6"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_keypad_btn"
                                android:text="6"
                                android:textColor="#F8FAFC"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:stateListAnimator="@null"
                                style="?android:attr/borderlessButtonStyle"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <Button
                                android:id="@+id/keypad7"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_keypad_btn"
                                android:text="7"
                                android:textColor="#F8FAFC"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:stateListAnimator="@null"
                                style="?android:attr/borderlessButtonStyle"/>

                            <Button
                                android:id="@+id/keypad8"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_keypad_btn"
                                android:text="8"
                                android:textColor="#F8FAFC"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:stateListAnimator="@null"
                                style="?android:attr/borderlessButtonStyle"/>

                            <Button
                                android:id="@+id/keypad9"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_keypad_btn"
                                android:text="9"
                                android:textColor="#F8FAFC"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:stateListAnimator="@null"
                                style="?android:attr/borderlessButtonStyle"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/keypadStar"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_keypad_btn"
                                android:text="*"
                                android:textColor="#38BDF8"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:stateListAnimator="@null"
                                style="?android:attr/borderlessButtonStyle"/>

                            <Button
                                android:id="@+id/keypad0"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_keypad_btn"
                                android:text="0"
                                android:textColor="#F8FAFC"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:stateListAnimator="@null"
                                style="?android:attr/borderlessButtonStyle"/>

                            <Button
                                android:id="@+id/keypadBackspace"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_keypad_btn"
                                android:text="⌫"
                                android:textColor="#FCA5A5"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:stateListAnimator="@null"
                                style="?android:attr/borderlessButtonStyle"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Cancel / Dismiss Button at the bottom -->
    <Button
        android:id="@+id/overlayCancelBtn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/btn_cancel_rounded"
        android:text="Cancel Session"
        android:textColor="#FCA5A5"
        android:textSize="15sp"
        android:textStyle="bold"
        android:drawableStart="@drawable/ic_close"
        android:drawablePadding="8dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:stateListAnimator="@null"
        style="?android:attr/borderlessButtonStyle"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"/>

</LinearLayout>
