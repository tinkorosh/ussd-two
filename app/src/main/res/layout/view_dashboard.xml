<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dashboardScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0C0E17">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="20dp"
        android:paddingBottom="36dp">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_badge"
                android:gravity="center">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_app_logo"
                    android:contentDescription="USSD Assistant Logo" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USSD Assistant"
                    android:textColor="#F8FAFC"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Interactive Touch Menus &amp; SIM Automation"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Mode pill -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DUAL SIM"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:background="@drawable/bg_sim1_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"/>
        </LinearLayout>

        <!-- ACCESSIBILITY PERMISSION GATE (Visible ONLY when service is OFF; removed when ON) -->
        <LinearLayout
            android:id="@+id/accessibilityCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <!-- Card Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_badge"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/accessibilityStatusIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_shield_check"
                        android:tint="#F59E0B"
                        android:contentDescription="Accessibility Alert" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SERVICE SETUP REQUIRED"
                        android:textColor="#F59E0B"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"/>

                    <TextView
                        android:id="@+id/accessibilityStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Turn On USSD Assistant"
                        android:textColor="#F8FAFC"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="To detect carrier menus and display 1-tap touch buttons on your screen, Android requires the Accessibility Service to be turned on."
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.25"
                android:layout_marginBottom="14dp"/>

            <!-- 3 Step Quick Guide Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_preset_item"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Tap 'Open Accessibility Settings' below."
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. Tap 'Installed Services' or 'Downloaded Apps'."
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. Select 'USSD Assistant' and toggle it ON."
                    android:textColor="#34D399"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="* Android 13+: If the toggle is restricted/greyed out, tap 'App Details' below, tap 3 dots in top corner, and choose 'Allow restricted settings'."
                    android:textColor="#64748B"
                    android:textSize="11sp"/>
            </LinearLayout>

            <!-- Action Buttons -->
            <Button
                android:id="@+id/btnOpenAccessibilitySettings"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_button_primary"
                app:backgroundTint="@null"
                android:text="Open Accessibility Settings"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_shield_check"
                android:drawablePadding="8dp"
                android:drawableTint="#FFFFFF"
                android:stateListAnimator="@null"
                android:layout_marginBottom="8dp"
                style="?android:attr/borderlessButtonStyle"/>

            <Button
                android:id="@+id/btnOpenAppDetails"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_button_test"
                app:backgroundTint="@null"
                android:text="App Details (Allow Restricted Settings)"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:stateListAnimator="@null"
                style="?android:attr/borderlessButtonStyle"/>

        </LinearLayout>

        <!-- QUICK ACTION PRESETS SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <!-- Section Header + Add Preset Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_badge"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_sim_card"
                        android:tint="#38BDF8"
                        android:contentDescription="SIM Presets" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QUICK ACTION PRESETS"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1-Tap Carrier Menus"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>

                <!-- Add Preset Button -->
                <Button
                    android:id="@+id/btnAddPreset"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_button_sim1"
                    app:backgroundTint="@null"
                    android:text="+ Add Preset"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:stateListAnimator="@null"
                    style="?android:attr/borderlessButtonStyle"/>
            </LinearLayout>

            <!-- Dynamic Presets Container -->
            <LinearLayout
                android:id="@+id/presetsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>

        <!-- CUSTOM USSD DIALER CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_badge"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_dialpad"
                        android:tint="#38BDF8"
                        android:contentDescription="Custom Dialer" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CUSTOM USSD DIALER"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Run Any USSD Request"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>
            </LinearLayout>

            <EditText
                android:id="@+id/customUssdInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:hint="e.g. *804# or *123#"
                android:textColorHint="#475569"
                android:textColor="#F8FAFC"
                android:textSize="15sp"
                android:textStyle="bold"
                android:inputType="phone"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="10dp"/>

            <!-- SIM Selection Radio Row -->
            <RadioGroup
                android:id="@+id/customSimRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <RadioButton
                    android:id="@+id/customRadioSim1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SIM 1"
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/customRadioSim2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SIM 2"
                    android:textColor="#C084FC"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </RadioGroup>

            <!-- Single Dial button strictly saying "Dial" -->
            <Button
                android:id="@+id/customDialBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_dial"
                app:backgroundTint="@null"
                android:text="Dial"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_phone"
                android:drawablePadding="8dp"
                android:drawableTint="#FFFFFF"
                android:gravity="center"
                android:stateListAnimator="@null"
                style="?android:attr/borderlessButtonStyle"/>
        </LinearLayout>

        <!-- Info Tip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_preset_item"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_info"
                android:tint="#38BDF8"
                android:contentDescription="Info"
                android:layout_marginTop="1dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Carrier menus are intercepted automatically with 1-tap option buttons and smart PIN auto-fill."
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.25"
                android:layout_marginStart="10dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
