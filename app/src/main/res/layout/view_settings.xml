<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0C0E17">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="36dp">

        <!-- Settings Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_sim"
                android:gravity="center">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_settings_gear"
                    android:contentDescription="Settings" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings &amp; Updates"
                    android:textColor="#F8FAFC"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="In-App OTA Updates &amp; SIM Defaults"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OTA READY"
                android:textColor="#34D399"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:background="@drawable/bg_status_active"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"/>
        </LinearLayout>

        <!-- CARD 1: GitHub In-App Updater -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon_badge"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_update"
                        android:contentDescription="Updater" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GITHUB RELEASES UPDATER"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"/>

                    <TextView
                        android:id="@+id/currentVersionText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Installed: v1.0 (Build 1)"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <!-- Status Badge -->
                <TextView
                    android:id="@+id/updateStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Up to date"
                    android:textColor="#34D399"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_status_active"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/updateDescriptionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connected to tinkorosh/ussd-two releases. Whenever you push to main, updates are published automatically."
                android:textColor="#64748B"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.25"
                android:layout_marginBottom="16dp"/>

            <!-- Release Details Box (Shown when a release is fetched) -->
            <LinearLayout
                android:id="@+id/releaseDetailsBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_preset_item"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/releaseTagText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="New Release v1.0.1"
                        android:textColor="#38BDF8"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/releaseSizeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="~12 MB"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/releaseNotesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Automated build with enhancements and bug fixes."
                    android:textColor="#CBD5E1"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.2"
                    android:maxLines="4"
                    android:ellipsize="end"/>
            </LinearLayout>

            <!-- Download Progress Bar (Shown during download) -->
            <LinearLayout
                android:id="@+id/downloadProgressBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <ProgressBar
                    android:id="@+id/downloadProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#38BDF8"
                    android:progressBackgroundTint="#1E2538"/>

                <TextView
                    android:id="@+id/downloadProgressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Downloading: 0%"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/downloadInstallBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button_primary"
                    android:text="Download &amp; Install Update"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:drawableStart="@drawable/ic_update"
                    android:drawablePadding="10dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:stateListAnimator="@null"
                    style="?android:attr/borderlessButtonStyle"
                    android:visibility="gone"
                    android:layout_marginBottom="10dp"/>

                <Button
                    android:id="@+id/checkUpdateBtn"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_button_sim1"
                    android:text="Check for Updates Now"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:drawableStart="@drawable/ic_refresh"
                    android:drawablePadding="10dp"
                    android:drawableTint="#FFFFFF"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:stateListAnimator="@null"
                    style="?android:attr/borderlessButtonStyle"/>
            </LinearLayout>

        </LinearLayout>

        <!-- CARD 2: Dialing Preferences -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon_badge"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_sim_card"
                        android:contentDescription="SIM Prefs" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DIALING PREFERENCES"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Default SIM Slot"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose your preferred SIM card for executing one-tap USSD requests and quick dialed codes."
                android:textColor="#64748B"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.25"
                android:layout_marginBottom="14dp"/>

            <RadioGroup
                android:id="@+id/simPreferenceRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/radioSimAsk"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Prompt / Choose Each Time"
                    android:textColor="#F8FAFC"
                    android:buttonTint="#38BDF8"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/radioSim1"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Always Default to SIM 1"
                    android:textColor="#F8FAFC"
                    android:buttonTint="#38BDF8"/>

                <RadioButton
                    android:id="@+id/radioSim2"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Always Default to SIM 2"
                    android:textColor="#F8FAFC"
                    android:buttonTint="#C084FC"/>
            </RadioGroup>

        </LinearLayout>

        <!-- CARD 3: Repository & About -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon_badge"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_github"
                        android:contentDescription="GitHub" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OPEN SOURCE REPOSITORY"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="tinkorosh/ussd-two"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Every commit pushed to the main branch automatically triggers GitHub Actions to compile and publish a fresh release."
                android:textColor="#64748B"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.25"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/openGithubRepoBtn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_button_test"
                android:text="Open Repository on GitHub"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_github"
                android:drawablePadding="10dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:stateListAnimator="@null"
                style="?android:attr/borderlessButtonStyle"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
